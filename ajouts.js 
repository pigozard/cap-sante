// Exemple : Simuler la complétion d'un module
window.demoModuleComplete = function() {
    window.showMessage(
        'success',
        'Module complété !',
        'Vous avez terminé le module "Introduction". Félicitations !'
    );
};

// Exemple : Simuler une erreur
window.demoError = function() {
    window.showMessage(
        'error',
        'Erreur de connexion',
        'Impossible de charger le contenu. Veuillez réessayer.'
    );
};

// Exemple : Simuler un warning
window.demoWarning = function() {
    window.showMessage(
        'warning',
        'Session bientôt expirée',
        'Votre session expirera dans 5 minutes. Pensez à sauvegarder.'
    );
};

